APP_NAME=AI-Based Intelligent File Retrieval System
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/ai_file_retrieval_db

FRONTEND_ORIGIN=http://localhost:5173

UPLOAD_DIR=app/data/uploads
FAISS_INDEX_DIR=app/data/indexes
MAX_UPLOAD_SIZE_MB=10

SESSION_COOKIE_NAME=ai_file_retrieval_session
SESSION_EXPIRE_HOURS=24
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
KEYWORD_SEARCH_WEIGHT=0.4
SEMANTIC_SEARCH_WEIGHT=0.6

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
RAG_SIMILARITY_THRESHOLD=0.35
